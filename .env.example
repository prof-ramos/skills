# =====================================================
# .env.example — Environment variables for this skills repo
# =====================================================
# 1. cp .env.example .env
# 2. Fill ONLY the real values in the LOCAL .env (never commit .env)
# 3. Each skill documents its own requirements in its SKILL.md

# --- GitHub (used by servers/supergithub/* and skills that call GitHub API)
# Create at https://github.com/settings/tokens
# Recommended scopes: repo (or public_repo for public-only)
# Only enable delete_repo if you really need the delete feature.
GH_TOKEN=ghp_seu_token_pessoal_aqui

# --- Assinafy (assinatura digital) — used by assinafy-api skill
# See assinafy/assinafy-api-docs/ and assinafy-api/references/integration-patterns.md
# NEVER put the real key in frontend code.
ASSINAFY_API_KEY=sua_chave_api_assinafy_aqui
ASSINAFY_ACCOUNT_ID=seu_account_id_aqui
ASSINAFY_BASE_URL=https://sandbox.assinafy.com.br/v1
ASSINAFY_WEBHOOK_SECRET=seu_webhook_secret_aqui

# Add variables for other skills as they are developed.
# Document them in the corresponding SKILL.md under "Variáveis de ambiente".

# IMPORTANT: After cloning on a new machine, always start from this .env.example.
# Real .env files are gitignored by design.
