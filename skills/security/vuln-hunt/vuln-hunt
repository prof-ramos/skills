#!/bin/bash
set -e

TARGET="${1:-.}"
AGENTS="${2:-40}"
PROFILE="redteam"
REPORT_DIR="/tmp/vuln-report-$(date +%Y%m%d-%H%M%S)"

echo "=================================================="
echo "     vuln-hunt v2.0 - James Red Team Pipeline"
echo "=================================================="
echo "Target      : $TARGET"
echo "Agents      : $AGENTS"
echo "Profile     : $PROFILE"
echo "Report      : $REPORT_DIR"
echo "=================================================="
echo ""

# Ensure profile and skills
hermes profile use redteam 2>/dev/null || echo "[+] Using GODMODE override with current profile"

mkdir -p "$REPORT_DIR/evidence"

echo "[1/3] Running Recon phase..."
echo "[2/3] Launching Hunt + Validate + Trace pipeline with $AGENTS agents..."

# Execute via the skill using Hermes internal mechanisms
hermes -s vuln-discovery-pipeline --target "$TARGET" --agents "$AGENTS" --report-dir "$REPORT_DIR" 2>&1 | tee "$REPORT_DIR/pipeline.log"

echo ""
echo "[3/3] Generating final report..."

cat > "$REPORT_DIR/README.txt" << EOL
Vulnerability Discovery Report
============================
Generated: $(date)
Target: $TARGET
Agents: $AGENTS

Main report: REPORT.md
Structured data: findings.json
Architecture: ARCHITECTURE.md
Raw logs: pipeline.log
Evidence: evidence/

Generated by vuln-hunt (powered by vuln-discovery-pipeline skill)
EOL

echo ""
echo "✅ Pipeline completed!"
echo "📊 Full report available at: $REPORT_DIR"
echo "📄 Main file: $REPORT_DIR/REPORT.md"
echo ""
echo "To view: cat $REPORT_DIR/REPORT.md | less"
echo "To open: xdg-open $REPORT_DIR/REPORT.md 2>/dev/null || true"
